{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "api/**",
      "ats/**",
      "coding_round/**",
      "hr_round/**",
      "module8/**",
      "orchestrator/**",
      "qgen/**",
      "aptitude_round/**",
      "config.py",
      "requirements.txt"
    ]
  },
  "deploy": {
    "healthcheckPath": "/docs",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}